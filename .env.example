# ─── Server ───
PORT=3000
LOG_LEVEL=info
# Comma-separated origins, or * to allow any
CORS_ORIGIN=*

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_bi_studio

# ─── AI Provider (optional — app runs with deterministic fallback without this) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
