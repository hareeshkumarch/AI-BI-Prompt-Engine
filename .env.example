# ─── Server ───
PORT=3000
LOG_LEVEL=info
# Comma-separated origins, or * to allow any
CORS_ORIGIN=*

# ─── Query engine ───
# duckdb (default, embedded and seeded in-process) or postgres
DATA_ENGINE=duckdb
QUERY_TIMEOUT_MS=15000
QUERY_MAX_ROWS=5000

# ─── Database (required only when DATA_ENGINE=postgres) ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_bi_studio

# ─── AI Provider (optional — app runs with deterministic fallback without this) ───
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_MS=20000
